rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin real: além de estar autenticado, o UID precisa existir em /admins.
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.uid == 'KfNaJsvIUMgpsPMPYRQ6017T1Ct2'
          ||
          (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('enabled', false) == true
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('disabled', false) != true
          )
        );
    }

    function isProfileHash(value) {
      return value.matches('^[0-9a-f]{64}$');
    }

    function validAuthor(data) {
      return data.author is string
        && data.author.size() >= 1
        && data.author.size() <= 40
        && data.authorId is string
        && data.authorId.size() >= 16
        && data.authorId.size() <= 80;
    }

    function validLocation(data) {
      return data.bookId is string
        && data.bookId.size() >= 1
        && data.bookId.size() <= 120
        && data.chapter is int
        && data.paraIdx is int
        && data.paraIdx >= -1
        && (data.get('paragraphKey', null) == null || data.get('paragraphKey', null) is string)
        && data.get('quote', '') is string
        && data.get('quote', '').size() <= 220;
    }

    function validReaderRole(data) {
      return isAdmin() || data.get('role', 'reader') == 'reader';
    }

    // ---------------------------------------------------------
    // ADMIN ALLOWLIST
    // Crie manualmente o primeiro documento:
    // /admins/SEU_FIREBASE_AUTH_UID
    // ---------------------------------------------------------
    match /admins/{uid} {
      // O utilizador autenticado precisa conseguir consultar apenas o próprio
      // UID para o app validar se aquela conta é administradora.
      allow get: if request.auth != null && request.auth.uid == uid;

      // Depois do primeiro bootstrap pelo Console, admins existentes podem
      // gerir a allowlist.
      allow list, create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // COMENTÁRIOS / RESPOSTAS / REAÇÕES
    // ---------------------------------------------------------
    match /comments/{commentId} {
      allow read: if true;

      // Comentário raiz.
      allow create: if request.resource.data.kind == 'comment'
        && request.resource.data.keys().hasOnly([
          'kind','bookId','chapter','paraIdx','paragraphKey','quote',
          'author','authorId','role','text','status','adminSeen','at','updatedAt'
        ])
        && validLocation(request.resource.data)
        && validAuthor(request.resource.data)
        && validReaderRole(request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.adminSeen is bool
        && (isAdmin() || request.resource.data.adminSeen == false)
        && request.resource.data.at is int
        && request.resource.data.updatedAt is int;

      // Resposta.
      allow create: if request.resource.data.kind == 'reply'
        && request.resource.data.keys().hasOnly([
          'kind','parentId','rootId','bookId','chapter','paraIdx',
          'paragraphKey','quote','author','authorId','role','text','at','updatedAt'
        ])
        && request.resource.data.parentId is string
        && request.resource.data.rootId is string
        && validLocation(request.resource.data)
        && validAuthor(request.resource.data)
        && validReaderRole(request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.at is int
        && request.resource.data.updatedAt is int;

      // Reação.
      allow create: if request.resource.data.kind == 'reaction'
        && request.resource.data.keys().hasOnly([
          'kind','bookId','chapter','paraIdx','paragraphKey','quote',
          'author','authorId','emoji','at','updatedAt'
        ])
        && validLocation(request.resource.data)
        && validAuthor(request.resource.data)
        && request.resource.data.emoji in ['😍','😂','😱','😢','🤔','😡']
        && request.resource.data.at is int
        && request.resource.data.updatedAt is int;

      // Admin pode editar qualquer feedback.
      allow update: if isAdmin();

      // Leitor: editar texto próprio no formato que o app usa.
      // Como os beta readers ainda não usam Firebase Auth, authorId não é uma
      // identidade criptograficamente verificável. Mantemos os campos de
      // identidade/localização imutáveis e limitamos o que pode ser alterado.
      allow update: if resource.data.get('role', '') == 'reader'
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.bookId == resource.data.bookId
        && request.resource.data.chapter == resource.data.chapter
        && request.resource.data.paraIdx == resource.data.paraIdx
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['text','editedAt','updatedAt','adminSeen'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.get('adminSeen', false) == false
        && request.resource.data.updatedAt is int;

      // Quando um leitor responde, o app reabre o comentário raiz e marca-o
      // como não lido para o autor.
      allow update: if resource.data.kind == 'comment'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','adminSeen','updatedAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.adminSeen == false
        && request.resource.data.updatedAt is int;

      // Alterar reação já existente.
      allow update: if resource.data.kind == 'reaction'
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.bookId == resource.data.bookId
        && request.resource.data.chapter == resource.data.chapter
        && request.resource.data.paraIdx == resource.data.paraIdx
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['emoji','updatedAt','paragraphKey','quote'])
        && request.resource.data.emoji in ['😍','😂','😱','😢','🤔','😡']
        && request.resource.data.updatedAt is int
        && request.resource.data.get('quote', '') is string
        && request.resource.data.get('quote', '').size() <= 220;

      // Admin apaga qualquer item. Leitores precisam conseguir apagar os
      // próprios comentários/respostas/reações no desenho atual do app.
      allow delete: if isAdmin()
        || resource.data.get('role', '') == 'reader'
        || resource.data.get('kind', '') == 'reply'
        || resource.data.get('kind', '') == 'reaction';
    }

    // ---------------------------------------------------------
    // CONFIGURAÇÃO GLOBAL
    // ---------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['showAllComments'])
        && request.resource.data.showAllComments is bool;
    }

    // ---------------------------------------------------------
    // PERFIS PORTÁTEIS DOS LEITORES
    // O ID do documento é SHA-256 do código de acesso.
    // ---------------------------------------------------------
    match /readerProfiles/{profileHash} {
      allow get: if isProfileHash(profileHash);
      allow list: if isAdmin();

      allow create: if isAdmin();

      allow create: if isProfileHash(profileHash)
        && request.resource.data.keys().hasOnly([
          'readerId','name','createdAt','updatedAt','allowedBooks','initialBookId',
          'approvalStatus','accessEnabled'
        ])
        && request.resource.data.readerId is string
        && request.resource.data.readerId.size() >= 16
        && request.resource.data.readerId.size() <= 80
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.get('approvalStatus', '') == 'pending'
        && request.resource.data.get('accessEnabled', false) == true
        && request.resource.data.get('allowedBooks', []) is list
        && request.resource.data.get('allowedBooks', []).size() <= 1
        && request.resource.data.get('initialBookId', '') is string
        && (
          (request.resource.data.get('initialBookId', '') == ''
            && request.resource.data.get('allowedBooks', []).size() == 0)
          ||
          (request.resource.data.get('initialBookId', '') != ''
            && request.resource.data.get('allowedBooks', []).size() == 1
            && request.resource.data.get('allowedBooks', [])[0]
              == request.resource.data.get('initialBookId', ''))
        );

      // Admin libera livros ou transforma o perfil numa lápide de exclusão.
      allow update: if isAdmin();

      // O próprio app do leitor pode atualizar apenas nome + timestamp.
      // readerId, livros liberados e livro inicial permanecem imutáveis.
      allow update: if isProfileHash(profileHash)
        && resource.data.get('deleted', false) != true
        && request.resource.data.readerId == resource.data.readerId
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.updatedAt is int;

      // O app mantém uma lápide em vez de apagar o documento.
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // CÓDIGOS DE ACESSO DOS LEITORES
    // O código em texto fica separado do perfil público e só admins leem.
    // O leitor apenas sincroniza o próprio código para o painel.
    // ---------------------------------------------------------
    function validAccessCodeRecord(profileHash, data) {
      return isProfileHash(profileHash)
        && data.keys().hasOnly(['profileHash','readerId','accessCode','updatedAt'])
        && data.profileHash == profileHash
        && data.readerId is string
        && data.readerId.size() >= 16
        && data.readerId.size() <= 80
        && data.accessCode is string
        && data.accessCode.size() >= 4
        && data.accessCode.size() <= 24
        && data.updatedAt is int
        && exists(/databases/$(database)/documents/readerProfiles/$(profileHash))
        && get(/databases/$(database)/documents/readerProfiles/$(profileHash)).data.get('deleted', false) != true
        && get(/databases/$(database)/documents/readerProfiles/$(profileHash)).data.readerId == data.readerId;
    }

    match /readerAccessCodes/{profileHash} {
      allow read, delete: if isAdmin();

      allow create, update: if isAdmin()
        || validAccessCodeRecord(profileHash, request.resource.data);
    }

    // ---------------------------------------------------------
    // FEEDBACK ESTRUTURADO DOS BETA READERS
    // Capa, capítulo e opinião final do livro. Somente admins leem.
    // ---------------------------------------------------------
    function validBetaFeedbackIdentity(data) {
      return data.readerId is string
        && data.readerId.size() >= 16
        && data.readerId.size() <= 80
        && data.profileHash is string
        && isProfileHash(data.profileHash)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && exists(/databases/$(database)/documents/readerProfiles/$(data.profileHash))
        && get(/databases/$(database)/documents/readerProfiles/$(data.profileHash)).data.get('deleted', false) != true
        && get(/databases/$(database)/documents/readerProfiles/$(data.profileHash)).data.readerId == data.readerId;
    }

    function validRating(value) {
      return value is int && value >= 0 && value <= 5;
    }

    function validBetaFeedback(data) {
      return data.keys().hasOnly([
          'schemaVersion','type','readerId','profileHash','name',
          'bookId','bookTitle','chapter','chapterTitle',
          'visualRating','openInterestRating','note',
          'tags','text',
          'overallRating','continueRating','pace','favoriteCharacter',
          'coverRepresentationRating','memorableMoment','hookMoment',
          'difficultPart','finalComment',
          'createdAt','updatedAt'
        ])
        && data.schemaVersion == 1
        && data.type in ['cover','chapter','book']
        && data.bookId is string
        && data.bookId.size() >= 1
        && data.bookId.size() <= 120
        && data.bookTitle is string
        && data.bookTitle.size() <= 180
        && data.createdAt is int
        && data.updatedAt is int
        && (
          data.type != 'cover'
          || (
            validRating(data.get('visualRating', 0))
            && data.get('visualRating', 0) >= 1
            && validRating(data.get('openInterestRating', 0))
            && data.get('openInterestRating', 0) >= 1
            && data.get('note', '') is string
            && data.get('note', '').size() <= 500
          )
        )
        && (
          data.type != 'chapter'
          || (
            data.chapter is int
            && data.chapter >= 1
            && data.chapterTitle is string
            && data.chapterTitle.size() <= 180
            && data.get('tags', []) is list
            && data.get('tags', []).size() <= 8
            && data.get('text', '') is string
            && data.get('text', '').size() <= 1500
          )
        )
        && (
          data.type != 'book'
          || (
            validRating(data.get('overallRating', 0))
            && data.get('overallRating', 0) >= 1
            && validRating(data.get('continueRating', 0))
            && data.get('continueRating', 0) >= 1
            && data.get('pace', '') in ['', 'slow', 'balanced', 'fast']
            && data.get('favoriteCharacter', '') is string
            && data.get('favoriteCharacter', '').size() <= 100
            && validRating(data.get('coverRepresentationRating', 0))
            && data.get('memorableMoment', '') is string
            && data.get('memorableMoment', '').size() <= 1200
            && data.get('hookMoment', '') is string
            && data.get('hookMoment', '').size() <= 1200
            && data.get('difficultPart', '') is string
            && data.get('difficultPart', '').size() <= 1200
            && data.get('finalComment', '') is string
            && data.get('finalComment', '').size() <= 1800
          )
        );
    }

    match /betaFeedback/{feedbackId} {
      allow read, delete: if isAdmin();
      allow create, update: if validBetaFeedbackIdentity(request.resource.data)
        && validBetaFeedback(request.resource.data);
    }

    // ---------------------------------------------------------
    // PRESENÇA AO VIVO DOS LEITORES BETA
    // Heartbeat curto para o painel do autor saber se o leitor está
    // realmente ativo no capítulo e em qual ponto está.
    // ---------------------------------------------------------
    function validReaderPresence(readerId, data) {
      return data.keys().hasOnly([
          'readerId','profileHash','name','heartbeatAt','lastInteractionAt',
          'view','visible','active','mode',
          'bookId','bookTitle','chapter','chapterTitle','currentPct',
          'narrationOn','musicOn'
        ])
        && data.readerId is string
        && data.readerId == readerId
        && data.readerId.size() >= 16
        && data.readerId.size() <= 80
        && data.profileHash is string
        && isProfileHash(data.profileHash)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.heartbeatAt is int
        && data.lastInteractionAt is int
        && data.view in ['library','book','reader']
        && data.visible is bool
        && data.active is bool
        && data.mode in ['reading','narration','idle','app']
        && data.bookId is string
        && data.bookId.size() <= 120
        && data.bookTitle is string
        && data.bookTitle.size() <= 180
        && data.chapter is int
        && data.chapter >= 0
        && data.chapterTitle is string
        && data.chapterTitle.size() <= 180
        && data.currentPct is int
        && data.currentPct >= 0
        && data.currentPct <= 100
        && data.narrationOn is bool
        && data.musicOn is bool
        && exists(/databases/$(database)/documents/readerProfiles/$(data.profileHash))
        && get(/databases/$(database)/documents/readerProfiles/$(data.profileHash)).data.get('deleted', false) != true
        && get(/databases/$(database)/documents/readerProfiles/$(data.profileHash)).data.readerId == readerId;
    }

    // ---------------------------------------------------------
    // DIAGNÓSTICO DE SINCRONIZAÇÃO
    // Sinal de vida + último erro do app do leitor. Propositalmente NÃO
    // depende do perfil estar consistente, para o autor ver por que as
    // métricas de um leitor não chegam. Somente admins leem.
    // ---------------------------------------------------------
    match /readerDiagnostics/{readerId} {
      allow read, delete: if isAdmin();
      allow create, update: if readerId.size() >= 16
        && readerId.size() <= 80
        && request.resource.data.keys().hasOnly([
          'readerId','profileHash','name','appVersion','seenAt','visible',
          'standalone','online','ua','lastOkAt','lastOkWhere',
          'lastErrorAt','lastError','lastErrorWhere','errorCount'
        ])
        && request.resource.data.readerId == readerId
        && request.resource.data.profileHash is string
        && request.resource.data.profileHash.size() <= 64
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 40
        && request.resource.data.seenAt is int
        && request.resource.data.ua is string
        && request.resource.data.ua.size() <= 200
        && request.resource.data.lastError is string
        && request.resource.data.lastError.size() <= 300
        && request.resource.data.lastErrorWhere is string
        && request.resource.data.lastErrorWhere.size() <= 40
        && request.resource.data.lastOkWhere is string
        && request.resource.data.lastOkWhere.size() <= 40
        && request.resource.data.errorCount is int;
    }

    match /readerPresence/{readerId} {
      allow read, delete: if isAdmin();
      allow create, update: if validReaderPresence(readerId, request.resource.data);
    }

    // ---------------------------------------------------------
    // ANALYTICS DOS LEITORES BETA
    // Leitor escreve apenas métricas ligadas ao próprio perfil portátil.
    // Somente admins podem ler os relatórios.
    // ---------------------------------------------------------
    function validAnalyticsIdentity(readerId, data) {
      return data.readerId is string
        && data.readerId == readerId
        && data.readerId.size() >= 16
        && data.readerId.size() <= 80
        && data.profileHash is string
        && isProfileHash(data.profileHash)
        && exists(/databases/$(database)/documents/readerProfiles/$(data.profileHash))
        && get(/databases/$(database)/documents/readerProfiles/$(data.profileHash)).data.get('deleted', false) != true
        && get(/databases/$(database)/documents/readerProfiles/$(data.profileHash)).data.readerId == readerId;
    }

    function validAnalyticsSummary(data) {
      return data.keys().hasOnly([
          'readerId','profileHash','name','updatedAt','lastActiveAt',
          'currentBookId','currentBookTitle','currentChapter','currentChapterTitle','currentChapterPct',
          'totalActiveSec','totalNarrationSec','totalMusicSec',
          'completedChapters','narrationChapters','musicChapters',
          'theme','font','fontScale','hideArt','autoAmbient',
          'themeChanges','fontChanges','fontScaleChanges'
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.updatedAt is int
        && data.get('lastActiveAt', 0) is int
        && data.get('currentBookId', '') is string
        && data.get('currentBookId', '').size() <= 120
        && data.get('currentBookTitle', '') is string
        && data.get('currentBookTitle', '').size() <= 180
        && data.get('currentChapter', 0) is int
        && data.get('currentChapter', 0) >= 0
        && data.get('currentChapterPct', 0) is int
        && data.get('currentChapterPct', 0) >= 0
        && data.get('currentChapterPct', 0) <= 100
        && data.get('currentChapterTitle', '') is string
        && data.get('currentChapterTitle', '').size() <= 180
        && data.get('totalActiveSec', 0) is int
        && data.get('totalActiveSec', 0) >= 0
        && data.get('totalNarrationSec', 0) is int
        && data.get('totalNarrationSec', 0) >= 0
        && data.get('totalMusicSec', 0) is int
        && data.get('totalMusicSec', 0) >= 0
        && data.get('completedChapters', []) is list
        && data.get('completedChapters', []).size() <= 500
        && data.get('narrationChapters', []) is list
        && data.get('narrationChapters', []).size() <= 500
        && data.get('musicChapters', []) is list
        && data.get('musicChapters', []).size() <= 500
        && data.get('theme', '') is string
        && data.get('theme', '').size() <= 40
        && data.get('font', '') is string
        && data.get('font', '').size() <= 40
        && (
          data.get('fontScale', 1) is int
          || data.get('fontScale', 1) is float
        )
        && data.get('fontScale', 1) >= 0.8
        && data.get('fontScale', 1) <= 1.6
        && data.get('hideArt', false) is bool
        && data.get('autoAmbient', false) is bool
        && data.get('themeChanges', 0) is int
        && data.get('themeChanges', 0) >= 0
        && data.get('fontChanges', 0) is int
        && data.get('fontChanges', 0) >= 0
        && data.get('fontScaleChanges', 0) is int
        && data.get('fontScaleChanges', 0) >= 0;
    }

    function validAnalyticsChapter(data) {
      return data.keys().hasOnly([
          'readerId','profileHash','bookId','bookTitle','chapter','chapterTitle',
          'updatedAt','lastActiveAt','lastOpenedAt','currentPct',
          'activeSec','narrationSec','musicSec',
          'completed','completedAt','narrationUsed','musicUsed'
        ])
        && data.bookId is string
        && data.bookId.size() >= 1
        && data.bookId.size() <= 120
        && data.get('bookTitle', '') is string
        && data.get('bookTitle', '').size() <= 180
        && data.chapter is int
        && data.chapter >= 1
        && data.get('chapterTitle', '') is string
        && data.get('chapterTitle', '').size() <= 180
        && data.updatedAt is int
        && data.get('lastActiveAt', 0) is int
        && data.get('lastOpenedAt', 0) is int
        && data.get('currentPct', 0) is int
        && data.get('currentPct', 0) >= 0
        && data.get('currentPct', 0) <= 100
        && data.get('activeSec', 0) is int
        && data.get('activeSec', 0) >= 0
        && data.get('narrationSec', 0) is int
        && data.get('narrationSec', 0) >= 0
        && data.get('musicSec', 0) is int
        && data.get('musicSec', 0) >= 0
        && data.get('completed', false) is bool
        && data.get('completedAt', 0) is int
        && data.get('completedAt', 0) >= 0
        && data.get('narrationUsed', false) is bool
        && data.get('musicUsed', false) is bool;
    }

    match /readerAnalytics/{readerId} {
      allow read: if isAdmin();

      allow create, update: if validAnalyticsIdentity(readerId, request.resource.data)
        && validAnalyticsSummary(request.resource.data);

      allow delete: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if isAdmin();

        allow create, update: if validAnalyticsIdentity(readerId, request.resource.data)
          && validAnalyticsChapter(request.resource.data);

        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------
    // RECADOS GERAIS LEGADOS
    // ---------------------------------------------------------
    match /announcements/{announceId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['text','createdAt','authorId'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is int;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // MODELOS DE POPUP
    // ---------------------------------------------------------
    match /popupTemplates/{templateId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // POPUPS INDIVIDUAIS
    // ---------------------------------------------------------
    match /popupMessages/{messageId} {
      // Necessário no desenho atual porque leitores não usam Firebase Auth.
      allow read: if true;

      allow create, delete: if isAdmin();
      allow update: if isAdmin();

      // O leitor só pode marcar uma mensagem como exibida/lida.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['shownAt','readAt','updatedAt'])
        && (request.resource.data.get('shownAt', null) == null
          || request.resource.data.get('shownAt', null) is int)
        && (request.resource.data.get('readAt', null) == null
          || request.resource.data.get('readAt', null) is int)
        && request.resource.data.updatedAt is int;
    }

    // Tudo que não foi explicitamente permitido fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
